rules_version = '2';

// Photos live at rooms/{roomId}/photos/{uid}/{file}.jpg (thumbnails as {file}_t.jpg), voice notes at rooms/{roomId}/voice/{uid}/{file}.webm|m4a
// Readable by room members; writable only by the uploader, once, as a small image.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(roomId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.members;
    }

    match /rooms/{roomId}/photos/{uid}/{file} {
      allow read: if isMember(roomId);
      allow create: if isMember(roomId)
        && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]{1,64}[.]jpg$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // View-once / view-twice photos: rooms/{roomId}/once/{uid}/{tabId}/{msgId}.jpg.
    // Only the recipient may read it, and only while the message still has views left.
    // The sender can't read it back. A Cloud Function deletes the file when it's used up.
    match /rooms/{roomId}/once/{uid}/{tabId}/{file} {
      function msg() {
        return firestore.get(/databases/(default)/documents/rooms/$(roomId)/tabs/$(tabId)/messages/$(file.split('[.]')[0])).data;
      }
      allow read: if isMember(roomId)
        && request.auth.uid != uid
        && msg().uid == uid
        && msg().get('viewLimit', 0) > 0
        && msg().get('viewCount', 0) < msg().viewLimit
        && msg().get('deleted', false) != true;
      allow create: if isMember(roomId)
        && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]{1,64}[.]jpg$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Voice notes: rooms/{roomId}/voice/{uid}/{file}.webm|m4a
    match /rooms/{roomId}/voice/{uid}/{file} {
      allow read: if isMember(roomId);
      allow create: if isMember(roomId)
        && request.auth.uid == uid
        && file.matches('^[A-Za-z0-9_-]{1,64}[.](webm|m4a)$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }

    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
