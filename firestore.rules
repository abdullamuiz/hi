rules_version = '2';

// Drops Chat — Firestore security rules.
//
// Data model (see docs/ARCHITECTURE.md):
//   users/{uid}                                   private: theme, read receipts, quiet hours, urgent count (server)
//   users/{uid}/tokens/{fcmToken}                 private: push tokens
//   users/{uid}/reads/{roomId}                     private: my own "read up to" per tab
//   users/{uid}/contacts/{uid}                     private: my nickname for a contact, mute
//   users/{uid}/blocked/{uid}                      private: people I blocked
//   profiles/{uid}                                 public profile: name, photo, about, 24h note
//   rooms/{roomId}                                 owner, members[<=2], invites[<=1], inviteCode?, lastMessage?, left?
//     members/{uid}                                public profile, mood weather, lastRead per tab
//     tabs/{tabId}                                 parallel conversations ("General" + more)
//       messages/{id}                              chat messages (append-only)
//     scheduled/{id}                               a scheduled message: only its sender can see it
//     pins/{id}                                    scrapbook
//     drops/{dropId}                               a Drop card: type + content
//       sealed/{uid}_{key}                         a PRIVATE answer
//       locks/{uid}_{key}                          public "I locked {key}" marker
//       entries/{id}                               public, append-only lines
//       users/{uid}                                public per-user progress
//
// Hidden answers: a sealed doc can be read by its owner at any time, and by the
// other member only once (a) the owner has locked it and (b) the reader has a
// lock marker for the same key, which itself can only exist if the reader's own
// sealed doc is locked. A locked sealed doc can never be changed again.
//
// Every room is exactly two people. A person can be in many rooms (one per contact).
// Someone joins a room either with an invited, verified e-mail, or with the room's
// secret invite code from a share link. Non-members can never read a room.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isMember(roomId) { return signedIn() && me() in roomData(roomId).members; }
    // For writes made in the same batch that creates the room (room + profile + General tab).
    function isMemberAfter(roomId) {
      return signedIn() && me() in getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function incoming() { return request.resource.data; }
    function onlyKeys(keys) { return incoming().keys().hasOnly(keys); }
    function changedKeys() { return incoming().diff(resource.data).affectedKeys(); }
    function str(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }
    function isKey(k) { return k is string && k.matches('^[A-Za-z0-9-]{1,40}$'); }
    function validInvites(l) { return l is list && (l.size() == 0 || (l.size() == 1 && lowerEmail(l[0]))); }
    function lowerEmail(e) { return str(e, 3, 254) && e == e.lower() && e.matches('^[^@\\s]+@[^@\\s]+$'); }
    // Secret part of a share link: 16–64 URL-safe characters.
    function validCode(c) { return c is string && c.matches('^[A-Za-z0-9_-]{16,64}$'); }
    // Reaction codes (the six quick reactions). Codes, not emoji, so rules can name them.
    function reactionCodes() { return ['heart', 'laugh', 'wow', 'sad', 'up', 'fire']; }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      // The urgent-message count is kept by the server (Cloud Function) only.
      allow create: if signedIn() && me() == uid && !incoming().keys().hasAny(['urgent']);
      allow update: if signedIn() && me() == uid && !changedKeys().hasAny(['urgent']);

      // My own "read up to" times. Kept here too, so unread counts work with read receipts off.
      match /reads/{rid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && onlyKeys(['lastRead'])
          && incoming().lastRead is map
          && incoming().lastRead.size() <= 200;
      }

      match /tokens/{token} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && onlyKeys(['token', 'ua', 'updatedAt'])
          && incoming().token == token
          && str(incoming().ua, 0, 300)
          && incoming().updatedAt == request.time;
      }

      // My private name for a contact, and whether their chat is muted.
      match /contacts/{cid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && onlyKeys(['nickname', 'muted', 'mutedUntil', 'updatedAt'])
          && str(incoming().get('nickname', ''), 0, 40)
          && incoming().get('muted', false) is bool
          && (incoming().get('mutedUntil', null) == null || incoming().mutedUntil is timestamp)
          && incoming().updatedAt == request.time;
      }

      // People I blocked. They can't join my chats (checked on join below).
      match /blocked/{bid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && bid != uid
          && onlyKeys(['name', 'at'])
          && str(incoming().name, 0, 80)
          && incoming().at == request.time;
      }
    }

    // ---------------------------------------------------------------- profiles
    // Public profile. No e-mail here. Any signed-in person can read it, but they need
    // the uid, which only people you share a chat with ever see.
    match /profiles/{uid} {
      function validNote(n) {
        return n == null || (
          n is map
          && n.keys().hasOnly(['text', 'emoji', 'at'])
          && str(n.text, 0, 60)
          && str(n.emoji, 0, 16)
          && (n.text.size() > 0 || n.emoji.size() > 0)
          && n.at is timestamp
        );
      }
      // A photo is a small JPEG stored inline (works without Cloud Storage) or an https URL.
      function validPhoto(p) {
        return p == null || (
          p is string && p.size() <= 150000
          && (p.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') || p.matches('^https://[^\\s]+$'))
        );
      }
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && onlyKeys(['name', 'photo', 'about', 'note', 'updatedAt'])
        && str(incoming().name, 1, 40)
        && validPhoto(incoming().get('photo', null))
        && str(incoming().get('about', ''), 0, 80)
        && validNote(incoming().get('note', null))
        // A new or changed note is stamped with the server time (it expires after 24 h).
        && (incoming().get('note', null) == null
            || (resource != null && resource.data.get('note', null) == incoming().note)
            || incoming().note.at == request.time)
        && incoming().updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      function canSeeRoom() {
        return signedIn() && (
          me() in resource.data.members
          || (verifiedEmail() && myEmail() in resource.data.invites)
        );
      }
      allow get, list: if canSeeRoom();

      allow create: if signedIn()
        && onlyKeys(['owner', 'ownerName', 'members', 'invites', 'inviteCode', 'timezone', 'createdAt'])
        && (incoming().get('timezone', 'Indian/Maldives') is string && incoming().get('timezone', 'Indian/Maldives').size() <= 64)
        && incoming().owner == me()
        && incoming().members == [me()]
        // Invite now (one e-mail) or later (empty list).
        && validInvites(incoming().invites)
        && (incoming().get('inviteCode', null) == null || validCode(incoming().inviteCode))
        && str(incoming().ownerName, 0, 80)
        && incoming().createdAt == request.time;

      function validLastMessage() {
        let m = incoming().lastMessage;
        return m is map
          && m.keys().hasOnly(['id', 'uid', 'tabId', 'text', 'at'])
          && str(m.id, 1, 64) && str(m.tabId, 1, 40) && str(m.text, 0, 160)
          && m.uid == me()
          && (
            m.at == request.time
            // A correction (edit / delete of the latest message) keeps its time.
            || (resource.data.get('lastMessage', null) != null
                && resource.data.lastMessage.id == m.id
                && resource.data.lastMessage.at == m.at)
          );
      }

      // Nobody can join a chat someone has left, or the chat of someone who blocked them.
      function joinable() {
        return resource.data.get('left', null) == null
          && !exists(/databases/$(database)/documents/users/$(resource.data.owner)/blocked/$(me()));
      }

      allow update: if signedIn() && (
        // The invited partner joins with their verified e-mail. Afterwards the room
        // holds two members and no branch below can ever add a third.
        (
          resource.data.members.size() == 1
          && joinable()
          && verifiedEmail()
          && myEmail() in resource.data.invites
          && !(me() in resource.data.members)
          && changedKeys().hasOnly(['members', 'inviteCode'])
          && !incoming().keys().hasAny(['inviteCode'])
          && incoming().members == resource.data.members.concat([me()])
        )
        ||
        // Anyone signed in with the secret invite code joins (share link). The code is
        // used up: it's removed in the same write and any e-mail invite is cleared.
        (
          resource.data.members.size() == 1
          && joinable()
          && !(me() in resource.data.members)
          && validCode(resource.data.get('inviteCode', null))
          && changedKeys().hasOnly(['members', 'invites', 'inviteCode', 'joinCode'])
          && incoming().members == resource.data.members.concat([me()])
          && incoming().get('joinCode', '') == resource.data.inviteCode
          && !incoming().keys().hasAny(['inviteCode'])
          && incoming().invites == []
        )
        ||
        // The invitee declines an e-mail invite.
        (
          resource.data.members.size() == 1
          && verifiedEmail()
          && myEmail() in resource.data.invites
          && changedKeys().hasOnly(['invites'])
          && incoming().invites == []
        )
        ||
        // The owner invites someone (or changes/clears the invite, or makes/revokes
        // the share-link code) while still alone.
        (
          resource.data.owner == me()
          && resource.data.members.size() == 1
          && resource.data.get('left', null) == null
          && changedKeys().hasOnly(['invites', 'inviteCode'])
          && validInvites(incoming().invites)
          && (incoming().get('inviteCode', null) == null || validCode(incoming().inviteCode))
          && !(string(request.auth.token.get('email', '')).lower() in incoming().invites)
        )
        ||
        // A member leaves (remove contact / block). Only their own uid goes, and the
        // room remembers who left so it can never be re-joined.
        (
          me() in resource.data.members
          && resource.data.members.size() == 2
          && changedKeys().hasOnly(['members', 'left', 'invites'])
          && incoming().members == resource.data.members.removeAll([me()])
          && incoming().left == me()
          // Any old e-mail invite goes too, so the chat never shows up as an invitation again.
          && incoming().get('invites', []) == []
        )
        ||
        // A member records the latest message (for the chat list), in the same batch as the message.
        (
          me() in resource.data.members
          && changedKeys().hasOnly(['lastMessage'])
          && validLastMessage()
        )
      );
      // The last person in a room can delete it: a chat nobody joined yet, or one the other person left.
      allow delete: if signedIn() && me() in resource.data.members && resource.data.members.size() == 1;

      // -------------------------------------------------------- members
      match /members/{uid} {
        allow read: if isMember(roomId);
        allow create, update: if isMemberAfter(roomId)
          && me() == uid
          && onlyKeys(['uid', 'name', 'photoURL', 'mood', 'lastSeen', 'typingUntil', 'typingTab', 'lastRead'])
          && incoming().uid == uid
          // Optional fields: read with get() — touching a missing field is a rules error.
          && str(incoming().get('name', ''), 0, 80)
          && (incoming().get('photoURL', null) == null || str(incoming().photoURL, 0, 2048))
          && (incoming().get('mood', null) == null || incoming().mood in ['sunny', 'cloudy', 'foggy', 'stormy'])
          && (incoming().get('lastSeen', null) == null || incoming().lastSeen is timestamp)
          && (incoming().get('typingUntil', null) == null || incoming().typingUntil is timestamp)
          && (incoming().get('typingTab', null) == null || str(incoming().typingTab, 1, 40))
          && incoming().get('lastRead', {}) is map
          && incoming().get('lastRead', {}).size() <= 200;
        allow delete: if false;
      }

      // -------------------------------------------------------- tabs
      match /tabs/{tabId} {
        function validTab() {
          return str(incoming().name, 1, 30)
            && incoming().colour is string && incoming().colour.matches('^#[0-9A-Fa-f]{6}$')
            && incoming().archived is bool
            && incoming().order is number
            && incoming().mode in ['casual', 'work']
            && incoming().disappearing is bool
            && incoming().get('ttlHours', 24) in [24, 168, 2160]
            && (incoming().wallpaper == null || str(incoming().wallpaper, 1, 200));
        }
        allow read: if isMember(roomId);
        allow create: if isMemberAfter(roomId)
          && tabId.matches('^[A-Za-z0-9_-]{1,40}$')
          && onlyKeys(['name', 'colour', 'wallpaper', 'mode', 'disappearing', 'ttlHours', 'archived', 'order', 'createdBy', 'createdAt', 'lastMessageAt'])
          && incoming().createdBy == me()
          && incoming().createdAt == request.time
          && incoming().lastMessageAt == null
          && validTab();
        // Either member can rename, recolour, reorder, archive or switch disappearing
        // messages (the app posts the announcement in the same batch).
        // lastMessageAt is only ever "now" (written in the same batch as a message).
        allow update: if isMember(roomId)
          && changedKeys().hasOnly(['name', 'colour', 'archived', 'order', 'lastMessageAt', 'disappearing', 'ttlHours'])
          && validTab()
          && (!changedKeys().hasAny(['lastMessageAt']) || incoming().lastMessageAt == request.time)
          && !(tabId == 'general' && incoming().archived == true);
        allow delete: if false;

        // -------------------------------------------------------- messages
        match /messages/{msgId} {
          // Optional reply-quote on a new message.
          function validReply() {
            return incoming().get('replyTo', null) == null || (
              incoming().replyTo is map
              && incoming().replyTo.keys().hasOnly(['msgId', 'snippet', 'senderId'])
              && str(incoming().replyTo.msgId, 1, 64)
              && str(incoming().replyTo.snippet, 0, 160)
              && str(incoming().replyTo.senderId, 1, 128)
            );
          }
          // A reply to the other person's 24-hour note quotes it.
          function validNoteReply() {
            return incoming().get('replyToNote', null) == null || (
              incoming().replyToNote is map
              && incoming().replyToNote.keys().hasOnly(['text', 'emoji'])
              && str(incoming().replyToNote.text, 0, 60)
              && str(incoming().replyToNote.emoji, 0, 16)
            );
          }
          function schedPath() { return /databases/$(database)/documents/rooms/$(roomId)/scheduled/$(msgId); }
          // Urgent (may break through quiet hours; the server caps it at 3 a day).
          // Scheduled: delivered from my scheduled message with the same id, which must be
          // removed in the same write, so it can only ever be delivered once.
          function validFlags() {
            return incoming().get('urgent', true) == true
              && (
                !incoming().keys().hasAny(['scheduled'])
                || (incoming().scheduled == true
                    && exists(schedPath())
                    && get(schedPath()).data.senderId == me()
                    && get(schedPath()).data.tabId == tabId
                    && !existsAfter(schedPath()))
              );
          }
          function validText() {
            return incoming().kind == 'text'
              && str(incoming().text, 1, 4000)
              && onlyKeys(['uid', 'kind', 'text', 'replyTo', 'replyToNote', 'urgent', 'scheduled', 'expiresAt', 'createdAt'])
              && validNoteReply();
          }
          function validLink() {
            return incoming().kind == 'link'
              && str(incoming().text, 0, 4000)
              && onlyKeys(['uid', 'kind', 'text', 'link', 'replyTo', 'urgent', 'expiresAt', 'createdAt'])
              && incoming().link is map
              && incoming().link.status == 'pending'
              && str(incoming().link.url, 8, 2048)
              && incoming().link.url.matches('^https?://.+');
          }
          function validPhoto() {
            return incoming().kind == 'photo'
              && str(incoming().text, 0, 1000)
              && onlyKeys(['uid', 'kind', 'text', 'photo', 'replyTo', 'expiresAt', 'createdAt'])
              && incoming().photo is map
              && incoming().photo.keys().hasOnly(['path', 'width', 'height'])
              && incoming().photo.path is string
              && incoming().photo.path.matches('^rooms/' + roomId + '/photos/' + me() + '/[A-Za-z0-9_-]{1,64}[.]jpg$')
              && incoming().photo.width is int && incoming().photo.height is int;
          }
          // Voice note: the audio file is mine, in this room; a short waveform for the bubble.
          function validVoice() {
            return incoming().kind == 'voice'
              && incoming().text == ''
              && onlyKeys(['uid', 'kind', 'text', 'voice', 'replyTo', 'expiresAt', 'createdAt'])
              && incoming().voice is map
              && incoming().voice.keys().hasOnly(['path', 'durationMs', 'peaks', 'mime'])
              && incoming().voice.path is string
              && incoming().voice.path.matches('^rooms/' + roomId + '/voice/' + me() + '/[A-Za-z0-9_-]{1,64}[.](webm|m4a)$')
              && incoming().voice.durationMs is int
              && incoming().voice.durationMs > 0 && incoming().voice.durationMs <= 180000
              && incoming().voice.peaks is list && incoming().voice.peaks.size() <= 64
              && str(incoming().voice.mime, 1, 64)
              && incoming().voice.mime.matches('^audio/[A-Za-z0-9.+-]+$');
          }
          function validDrop() {
            return incoming().kind == 'drop'
              && str(incoming().text, 0, 200)
              && onlyKeys(['uid', 'kind', 'text', 'dropId', 'expiresAt', 'createdAt'])
              && incoming().dropId is string
              && getAfter(/databases/$(database)/documents/rooms/$(roomId)/drops/$(incoming().dropId)).data.createdBy == me();
          }

          // Disappearing tab: a new message must carry its expiry, matching the tab's
          // setting (as it is after this write) within an hour either way for clock drift.
          // Otherwise it must not have one.
          function tabPath() { return /databases/$(database)/documents/rooms/$(roomId)/tabs/$(tabId); }
          function validExpiry() {
            let t = getAfter(tabPath()).data;
            let ttl = duration.value(t.get('ttlHours', 24), 'h');
            return t.get('disappearing', false) == true
              ? (incoming().get('expiresAt', null) is timestamp
                  && incoming().expiresAt > request.time + ttl - duration.value(1, 'h')
                  && incoming().expiresAt < request.time + ttl + duration.value(1, 'h'))
              : !incoming().keys().hasAny(['expiresAt']);
          }
          // "Alice turned on disappearing messages (7 days)": only in the same write that
          // actually changes the tab's setting, and its hours must match the new setting.
          function validSystem() {
            let before = get(tabPath()).data;
            let after = getAfter(tabPath()).data;
            return incoming().kind == 'system'
              && onlyKeys(['uid', 'kind', 'text', 'system', 'ttlHours', 'expiresAt', 'createdAt'])
              && incoming().system == 'disappearing'
              && str(incoming().text, 1, 120)
              && incoming().ttlHours is int
              && incoming().ttlHours == (after.get('disappearing', false) == true ? after.get('ttlHours', 24) : 0)
              && (after.get('disappearing', false) != before.get('disappearing', false)
                  || after.get('ttlHours', 24) != before.get('ttlHours', 24));
          }

          function alive() { return resource.data.get('deleted', false) != true; }
          function mine() { return resource.data.uid == me(); }

          // Edit: the sender, text messages only, within 15 minutes; only text + editedAt change.
          function isEdit() {
            return mine() && alive()
              && resource.data.kind == 'text'
              && changedKeys().hasOnly(['text', 'editedAt'])
              && str(incoming().text, 1, 4000)
              && incoming().editedAt == request.time
              && request.time < resource.data.createdAt + duration.value(15, 'm');
          }
          // Delete for me: add or remove ONLY my own uid in hiddenFor.
          function isHide() {
            let before = resource.data.get('hiddenFor', []);
            let after = incoming().get('hiddenFor', []);
            return changedKeys().hasOnly(['hiddenFor'])
              && after is list && after.size() <= 2
              && after.removeAll([me()]) == before.removeAll([me()]);
          }
          // Delete for everyone: the sender only; content cleared, deleted = true.
          function isDeleteForEveryone() {
            return mine() && alive()
              && changedKeys().hasOnly(['deleted', 'text', 'link', 'photo', 'voice', 'dropId', 'replyTo', 'replyToNote', 'reactions', 'phraseReactions', 'voiceReactions', 'playedBy', 'editedAt'])
              && incoming().deleted == true
              && incoming().text == ''
              && !incoming().keys().hasAny(['link', 'photo', 'voice', 'dropId', 'replyTo', 'replyToNote', 'reactions', 'phraseReactions', 'voiceReactions', 'playedBy', 'editedAt']);
          }
          // Quick reactions: { code: [uid] }. Only my own uid may appear or disappear.
          function rxSame(k) {
            let before = resource.data.get('reactions', {}).get(k, []);
            let after = incoming().get('reactions', {}).get(k, []);
            return after is list && after.size() <= 2 && after.removeAll([me()]) == before.removeAll([me()]);
          }
          function isReact() {
            return alive()
              && changedKeys().hasOnly(['reactions'])
              && incoming().reactions is map
              && incoming().reactions.keys().hasOnly(reactionCodes())
              && rxSame('heart') && rxSame('laugh') && rxSame('wow')
              && rxSame('sad') && rxSame('up') && rxSame('fire');
          }
          // Phrase reactions: append one of mine, or remove one of mine.
          function validPhrase(p) {
            return p is map
              && p.keys().hasOnly(['uid', 'start', 'end', 'reaction'])
              && p.uid == me()
              && p.start is int && p.end is int
              && p.start >= 0 && p.end > p.start && p.end <= 4000
              && p.reaction in reactionCodes();
          }
          function isPhrase() {
            let before = resource.data.get('phraseReactions', []);
            let after = incoming().get('phraseReactions', []);
            return alive()
              && resource.data.kind == 'text'
              && changedKeys().hasOnly(['phraseReactions'])
              && after is list && after.size() <= 50
              && (
                (after.size() == before.size() + 1
                  && (before.size() == 0 || after[0:before.size()] == before)
                  && validPhrase(after[before.size()]))
                ||
                (after.size() == before.size() - 1
                  && after.removeAll(before).size() == 0
                  && before.removeAll(after).size() == 1
                  && before.removeAll(after)[0].uid == me())
              );
          }

          // Voice notes: "played" marks (my own uid only) and reactions at a moment in the audio.
          function isPlayed() {
            let before = resource.data.get('playedBy', []);
            let after = incoming().get('playedBy', []);
            return alive()
              && resource.data.kind == 'voice'
              && changedKeys().hasOnly(['playedBy'])
              && after is list && after.size() <= 2
              && after.removeAll([me()]) == before.removeAll([me()]);
          }
          function validVoiceReaction(r) {
            return r is map
              && r.keys().hasOnly(['uid', 'atMs', 'reaction'])
              && r.uid == me()
              && r.atMs is int && r.atMs >= 0 && r.atMs <= 180000
              && r.reaction in reactionCodes();
          }
          function isVoiceReact() {
            let before = resource.data.get('voiceReactions', []);
            let after = incoming().get('voiceReactions', []);
            return alive()
              && resource.data.kind == 'voice'
              && changedKeys().hasOnly(['voiceReactions'])
              && after is list && after.size() <= 50
              && (
                (after.size() == before.size() + 1
                  && (before.size() == 0 || after[0:before.size()] == before)
                  && validVoiceReaction(after[before.size()]))
                ||
                (after.size() == before.size() - 1
                  && after.removeAll(before).size() == 0
                  && before.removeAll(after).size() == 1
                  && before.removeAll(after)[0].uid == me())
              );
          }

          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && roomData(roomId).get('left', null) == null
            && exists(/databases/$(database)/documents/rooms/$(roomId)/tabs/$(tabId))
            && incoming().uid == me()
            && incoming().createdAt == request.time
            && validReply()
            && validFlags()
            && validExpiry()
            && (validText() || validLink() || validPhoto() || validVoice() || validDrop() || validSystem());
          // Link previews are filled in by a Cloud Function (Admin SDK bypasses rules).
          allow update: if isMember(roomId)
            && (isEdit() || isHide() || isDeleteForEveryone() || isReact() || isPhrase() || isPlayed() || isVoiceReact());
          allow delete: if false;
        }
      }

      // -------------------------------------------------------- scheduled messages
      // Only the sender can see or change them. The id becomes the message id on delivery.
      match /scheduled/{sid} {
        function validSched() {
          return str(incoming().text, 1, 4000)
            && incoming().tabId is string
            && exists(/databases/$(database)/documents/rooms/$(roomId)/tabs/$(incoming().tabId))
            && incoming().sendAt is timestamp
            && incoming().sendAt < request.time + duration.value(366, 'd')
            && (incoming().get('replyTo', null) == null || (
              incoming().replyTo is map
              && incoming().replyTo.keys().hasOnly(['msgId', 'snippet', 'senderId'])
              && str(incoming().replyTo.snippet, 0, 160)
            ));
        }
        allow get, list: if isMember(roomId) && resource.data.senderId == me();
        allow create: if isMember(roomId)
          && roomData(roomId).get('left', null) == null
          && sid.matches('^[A-Za-z0-9]{20}$')
          && onlyKeys(['senderId', 'tabId', 'text', 'replyTo', 'sendAt', 'createdAt'])
          && incoming().senderId == me()
          && incoming().createdAt == request.time
          && incoming().sendAt > request.time
          && validSched();
        allow update: if isMember(roomId)
          && resource.data.senderId == me()
          && changedKeys().hasOnly(['text', 'sendAt'])
          && validSched();
        // The sender can cancel, even after leaving the chat.
        allow delete: if signedIn() && resource.data.senderId == me();
      }

      // -------------------------------------------------------- scrapbook
      match /pins/{pinId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && onlyKeys(['by', 'title', 'detail', 'dropId', 'messageId', 'tabId', 'createdAt'])
          && (incoming().get('tabId', null) == null || incoming().tabId is string)
          && incoming().by == me()
          && str(incoming().title, 1, 120)
          && str(incoming().detail, 0, 3000)
          && (incoming().dropId == null || incoming().dropId is string)
          && (incoming().messageId == null || incoming().messageId is string)
          && incoming().createdAt == request.time;
        allow delete: if isMember(roomId) && resource.data.by == me();
        allow update: if false;
      }

      // -------------------------------------------------------- drops
      match /drops/{dropId} {
        function dropDoc(sub, id) {
          return /databases/$(database)/documents/rooms/$(roomId)/drops/$(dropId)/$(sub)/$(id);
        }

        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && onlyKeys(['type', 'createdBy', 'createdAt', 'content'])
          && incoming().createdBy == me()
          && str(incoming().type, 1, 40)
          && incoming().type.matches('^[a-z0-9-]+$')
          && incoming().content is map
          && incoming().createdAt == request.time;
        allow update, delete: if false;

        // A private answer. Doc id is always "{uid}_{key}".
        match /sealed/{sealId} {
          function validSealed() {
            return onlyKeys(['uid', 'key', 'value', 'locked', 'updatedAt'])
              && incoming().uid == me()
              && isKey(incoming().key)
              && sealId == me() + '_' + incoming().key
              && incoming().locked is bool
              && (!(incoming().value is string) || incoming().value.size() <= 500)
              && incoming().updatedAt == request.time;
          }

          allow get: if isMember(roomId) && (
            resource.data.uid == me()
            || (
              resource.data.locked == true
              && exists(dropDoc('locks', me() + '_' + resource.data.key))
            )
          );
          // Queries may only ever return the caller's own answers.
          allow list: if isMember(roomId) && resource.data.uid == me();

          allow create: if isMember(roomId) && validSealed();
          // Editable until locked; frozen forever after.
          allow update: if isMember(roomId)
            && resource.data.uid == me()
            && resource.data.locked != true
            && validSealed();
          allow delete: if false;
        }

        // Public marker "uid has locked key". Only creatable together with (or
        // after) locking the matching sealed doc.
        match /locks/{lockId} {
          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && onlyKeys(['uid', 'key', 'at'])
            && incoming().uid == me()
            && isKey(incoming().key)
            && lockId == me() + '_' + incoming().key
            && incoming().at == request.time
            && getAfter(dropDoc('sealed', lockId)).data.locked == true;
          allow update, delete: if false;
        }

        // Public, append-only contributions (e.g. Tag-team Story lines).
        match /entries/{entryId} {
          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && onlyKeys(['uid', 'text', 'createdAt'])
            && incoming().uid == me()
            && str(incoming().text, 1, 280)
            && incoming().createdAt == request.time;
          allow update, delete: if false;
        }

        // Public per-user progress (e.g. which Feeling Map scene I'm on).
        match /users/{uid} {
          allow read: if isMember(roomId);
          allow create, update: if isMember(roomId) && me() == uid && incoming().size() <= 20;
          allow delete: if false;
        }
      }
    }
  }
}
